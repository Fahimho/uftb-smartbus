rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if the user has a specific role
    // FIXED: Added exists() check to prevent evaluation errors if user doc is missing
    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Helper function: Check if user is an Admin or Operator
    function isAdminOrOperator() {
      return hasRole('admin') || hasRole('operator');
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdminOrOperator());
      allow create: if isAdminOrOperator();
      allow update: if (isAdminOrOperator() && request.auth.uid != userId) || 
                      (request.auth.uid == userId && 
                       request.resource.data.role == resource.data.role);
      allow delete: if hasRole('admin');
    }

    // 2. STUDENTS COLLECTION
    match /students/{studentId} {
      allow read, write: if isAdminOrOperator();
    }

    // 3. BUSES & DEVICES
    match /buses/{busId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }
    
    // 4. EMERGENCIES
    match /emergencyEvents/{eventId} {
      allow read: if isAdminOrOperator();
      allow create: if isAuthenticated(); 
      allow update: if isAdminOrOperator(); 
    }

    // 5. TRIPS & ATTENDANCE (Students blocked here)
    match /trips/{tripId} {
      allow read, write: if isAdminOrOperator();
    }
    
    match /tripAttendance/{eventId} {
      allow read: if isAdminOrOperator();
      allow create: if isAuthenticated(); 
      allow update, delete: if false; 
    }

    // 6. CAPTURE PHOTO REQUESTS (MUST BE BEFORE DEFAULT DENY)
    match /capturePhotoRequests/{requestId} {
      allow read: if isAdminOrOperator();
      allow create, update: if true; 
    }

    // 7. GPS History (For the blue trail line)
    match /gpsHistory/{docId} {
      allow read: if isAuthenticated();
      allow create: if true; 
    }

    // 7.5 BUS REQUESTS (Student Stop Requests)
    match /busRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // 8. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}